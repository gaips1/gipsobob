[Unit]
Description=gipsobob
After=network.target

[Service]
User=deploy
Group=deploy
Type=simple
WorkingDirectory=/opt/gipsobob
ExecStart=/opt/gipsobob/target/release/gipsobob
EnvironmentFile=/opt/gipsobob/.env
Restart=always
RestartSec=5

KillMode=control-group
TimeoutStopSec=20
KillSignal=SIGTERM
SendSIGKILL=yes

RemainAfterExit=no

[Install]
WantedBy=multi-user.target